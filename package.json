{
  "name": "switchboard-cli",
  "version": "0.1.11",
  "description": "Switchboard CLI for deploying and operating Acurast ingress workloads.",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "switchboard": "dist/index.js"
  },
  "files": [
    "assets",
    "dist/index.js",
    "dist/internal",
    "install.sh",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "prepare": "node scripts/build-package.mjs && node scripts/verify-package-artifacts.mjs",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "smoke:express-local": "node --import tsx --test tests/express-webserver-local-harness.test.ts",
    "typecheck": "tsc --noEmit",
    "example:express-webserver": "tsx examples/express-webserver/src/index.ts",
    "switchboard": "tsx cli/src/index.ts",
    "switchboard:internal:deploy-runner": "tsx scripts/acurast/switchboard-deploy.ts",
    "switchboard:validator:run": "tsx scripts/validation/route-validator.ts",
    "operator:setup": "tsx cli/src/index.ts operator setup",
    "operator:discover": "tsx cli/src/index.ts operator discover",
    "acurast:prepare-express": "tsx scripts/acurast/express-harness.ts prepare",
    "acurast:estimate-express": "tsx scripts/acurast/express-harness.ts estimate-fee",
    "acurast:deploy-express:dry-run": "tsx scripts/acurast/express-harness.ts deploy-dry-run",
    "acurast:deploy-express": "tsx scripts/acurast/express-harness.ts deploy",
    "acurast:deploy-express:direct": "tsx scripts/acurast/express-harness.ts deploy-direct",
    "acurast:update-env-express": "tsx scripts/acurast/express-harness.ts update-env",
    "acurast:status-express": "tsx scripts/acurast/express-harness.ts status",
    "acurast:inspect-express": "tsx scripts/acurast/express-harness.ts inspect",
    "acurast:list-processors": "tsx scripts/acurast/list-manager-processors.ts",
    "hub:fund-evm-session": "tsx scripts/hub/fund-evm-session.ts",
    "hub:fund-native-asset-quote": "tsx scripts/hub/fund-asset-quote-native.ts",
    "hub:read-session": "tsx scripts/hub/read-session.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proof-computer/switchboard-cli.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "@polkadot/api": "^16.5.6",
    "@polkadot/keyring": "^14.0.3",
    "@polkadot/util": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "acme-client": "^5.4.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "ethers": "^6.15.0",
    "express": "^5.2.1",
    "solc": "^0.8.30",
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "@ledgerhq/hw-transport-node-hid-singleton": "6.31.5",
    "@zondax/ledger-substrate": "1.1.1"
  },
  "peerDependenciesMeta": {
    "@ledgerhq/hw-transport-node-hid-singleton": {
      "optional": true
    },
    "@zondax/ledger-substrate": {
      "optional": true
    }
  },
  "devDependencies": {
    "@acurast/cli": "0.8.1",
    "@ledgerhq/hw-transport-node-hid-singleton": "6.31.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@zondax/ledger-substrate": "1.1.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "license": "UNLICENSED"
}
